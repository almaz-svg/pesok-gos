{
  "name": "zher-monitoring-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot for Kazakhstan land monitoring reports",
  "type": "module",
  "scripts": {
    "start": "node --watch --watch-path=./src --watch-path=./.env --watch-path=./package.json --watch-preserve-output src/index.js",
    "dev": "npm run start",
    "start:once": "node src/index.js",
    "test": "node --test",
    "update:boundaries": "node scripts/update-boundaries.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@turf/area": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "dotenv": "^16.4.7",
    "geotiff": "^3.0.5",
    "openai": "^7.23.0",
    "pngjs": "^7.0.0",
    "proj4": "^2.22.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "osmtogeojson": "^3.0.0-beta.5"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  }
}
