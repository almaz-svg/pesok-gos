# Local development only. Copy to .env and replace secrets before sharing/deploying.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-local-db-password
# Docker Compose overrides DATABASE_URL with its db hostname.
DATABASE_URL=postgresql://pesok:replace-local-db-password@localhost:5432/pesok
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
BOT_API_KEY=replace-with-a-separate-random-service-key
BOT_TOKEN=
SECURE_SSL_REDIRECT=false
TRUST_PROXY=false

# Frontend: only VITE_* values are exposed to the browser. Never prefix secrets with VITE_.
# demo: вымышленные данные с сохранением в браузере; api: Django.
VITE_DATA_MODE=demo
# /api использует Vite proxy на localhost:8000 при локальной разработке.
VITE_API_BASE_URL=/api
