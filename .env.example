# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN=

# Django API из технического задания
API_BASE_URL=http://127.0.0.1:8000/api

# Telegram Bot API. Оставьте по умолчанию или укажите локальный/прокси API root.
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_STARTUP_TIMEOUT_MS=15000
TELEGRAM_SETUP_PROFILE=true

# mock — локальные DEMO-данные; api — Django backend
DATA_MODE=mock

# OpenAI: необязательно. Пустой ключ отключает обсуждение с ИИ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
