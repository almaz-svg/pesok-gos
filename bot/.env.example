# Из корня репозитория: cd bot, npm ci, Copy-Item .env.example .env (только первый запуск).
# Затем задайте BOT_TOKEN в bot/.env и выполните npm start из bot/.
# Пути .env и data/ относительны bot/. Не перезаписывайте существующий .env.
# bot/.env, bot/data/reports.json и bot/data/user-preferences.json исключены из Git.
# Резервируйте их перед миграцией; новые приватные файлы добавляйте в .gitignore.
# Этот PR не копирует секреты и не мигрирует runtime-данные.

# Токен Telegram-бота, полученный у @BotFather; нужен и для mock.
BOT_TOKEN=

# Адрес старого API-клиента; в mock не используется.
# Django уже есть в ../backend; авторитетный контракт: ../docs/backend-design.md.
# Клиент несовместим с этим Django, адаптер отложен; смена URL не подключает API.
API_BASE_URL=http://127.0.0.1:8000/api

# Telegram Bot API. Оставьте по умолчанию или укажите локальный/прокси API root.
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_STARTUP_TIMEOUT_MS=15000
TELEGRAM_SETUP_PROFILE=true

# mock — единственный поддерживаемый режим текущего комплекта проекта.
# api — старый клиент, пока не совместимый с bundled Django.
# Django требует Bearer BOT_API_KEY (не BOT_TOKEN), Idempotency-Key и вложенный
# snake_case POST с category; текущий клиент это не реализует и BOT_API_KEY не читает.
# Нужны /tracking с проверкой владельца вместо /applications, /instructions вместо /procedures.
# Для кабинета нет bot-authorized списка; inspector GET /reports нельзя использовать
# с bot key или открывать анонимно. Подробности: README.md.
DATA_MODE=mock
